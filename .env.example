# ==========================================
# DOPPEL Environment Configuration
# ==========================================

# Core Application Settings
PROJECT_NAME="DOPPEL"
SECRET_KEY="doppel-super-secure-production-secret-key-change-in-prod-128bits"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Async SQLite or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./doppel.db"
SYNC_DATABASE_URL="sqlite:///./doppel.db"
# For PostgreSQL + pgvector in production:
# DATABASE_URL="postgresql+asyncpg://doppel:secret@localhost:5432/doppel_db"

# Vector Store Engine (memory | qdrant | postgres)
VECTOR_BACKEND="memory"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="doppel_face_vectors"

# Face AI Model Parameters
EMBEDDING_DIMENSION=512
MODEL_NAME="ArcFace-MobileFaceNet-ONNX"
MODEL_VERSION="v1.2.0"
DEFAULT_MATCH_THRESHOLD=0.58
TOP_K_MATCHES=10
MAX_IMAGE_SIZE_BYTES=10485760

# Image Quality Thresholds
MIN_QUALITY_SCORE=0.55
MIN_BLUR_SCORE=60.0
MIN_BRIGHTNESS=35.0
MAX_BRIGHTNESS=230.0
MIN_FACE_PERCENTAGE=0.08

# LLM & RAG Provider (mock | ollama | openai_compatible)
LLM_PROVIDER="mock"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Frontend Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
